# Copy to .env and adjust.

# Use the GPU build + NVIDIA runtime by default (`docker compose up --build`)
COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# Host port
PORT=8000

# Optional HTTP Basic auth (leave APP_PASSWORD empty to disable)
APP_USER=admin
APP_PASSWORD=

# Owner of files in ./data (run `id -u` / `id -g`)
PUID=1000
PGID=1000

# Finished training runs kept per project (older ones are deleted automatically)
KEEP_JOBS=10
